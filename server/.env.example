# Copie para .env e preencha. NUNCA publique o .env.
PORT=3001
# Atlas: mongodb+srv://USUARIO:SENHA@cluster.xxxxx.mongodb.net/   |  Local: mongodb://127.0.0.1:27017
MONGODB_URI=
# Gere um segredo longo e aleatório:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Endereço(s) do front-end autorizados (separados por vírgula)
CORS_ORIGIN=http://localhost:5173
# Só para testar sem banco (dados somem ao reiniciar):  STORE=memory
